# Copy this file to .env.local (git-ignored) and fill in the key.
# With both values set the app uses Supabase; without them it uses the in-browser mock data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> the public "anon" (or "publishable") key.
# NEVER put the service_role / secret key here: anything VITE_* ships to the browser.
VITE_SUPABASE_ANON_KEY=
